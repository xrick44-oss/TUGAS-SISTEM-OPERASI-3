#!/bin/bash
# ============================================================
# PANDUAN LENGKAP PUSH KE GITHUB - UNTUK PEMULA
# ============================================================

echo "=========================================="
echo "    PANDUAN PUSH TUGAS KE GITHUB          "
echo "=========================================="
echo ""

echo "LANGKAH 1: Buat Repository di GitHub"
echo "------------------------------------------"
echo "1. Buka github.com dan login"
echo "2. Klik tombol 'New' (atau '+' di pojok kanan atas)"
echo "3. Isi Repository name: tugas-linux-50-command"
echo "4. Biarkan Public/Private sesuai keinginan"
echo "5. Jangan centang 'Add a README file'"
echo "6. Klik 'Create repository'"
echo ""

echo "LANGKAH 2: Setup Git di Terminal Ubuntu"
echo "------------------------------------------"
echo "# Set nama dan email kamu (WAJIB!)"
echo "git config --global user.name \"Nama Kamu\""
echo "git config --global user.email \"emailkamu@gmail.com\""
echo ""

echo "LANGKAH 3: Inisialisasi & Tambahkan File"
echo "------------------------------------------"
echo "# Masuk ke folder tugas"
echo "cd /path/to/tugas-linux-50-command"
echo ""
echo "# Inisialisasi Git"
echo "git init"
echo ""
echo "# Tambahkan semua file"
echo "git add ."
echo ""
echo "# Cek status (pastikan file sudah terdaftar)"
echo "git status"
echo ""

echo "LANGKAH 4: Commit (Simpan Perubahan)"
echo "------------------------------------------"
echo "git commit -m \"Tugas Linux: 50 Command Dasar\""
echo ""

echo "LANGKAH 5: Hubungkan ke GitHub & Push"
echo "------------------------------------------"
echo "# Hubungkan ke repository GitHub (GANTI 'username' dan 'repo')"
echo "git remote add origin https://github.com/username/tugas-linux-50-command.git"
echo ""
echo "# Kirim ke GitHub"
echo "git push -u origin main"
echo ""

echo "=========================================="
echo "   TIPS JIKA ERROR 'main' TIDAK DITEMUKAN "
echo "=========================================="
echo "Jika muncul error, coba:"
echo "git branch -M main          # Rename branch ke main"
echo "git push -u origin main     # Push lagi"
echo ""
echo "Atau jika pakai branch 'master':"
echo "git push -u origin master"
echo ""

echo "=========================================="
echo "      SELESAI! CEK GITHUB KAMU           "
echo "=========================================="
